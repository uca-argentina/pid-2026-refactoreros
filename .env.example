# Debe crear un archivo .env con esta estructura, cambiando los valores.
# Estos valores son solo para desarrollo local.

# Correos de cancelación (por defecto se imprimen en consola).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=Butaca Cero <no-reply@example.com>
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=usuario
# DJANGO_EMAIL_HOST_PASSWORD=password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False

POSTGRES_DB=butacacero_db
POSTGRES_USER=butacacero
POSTGRES_PASSWORD=change-me-local-password

DJANGO_PORT=8000
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-local-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
