# Debe crear un archivo .env con esta estructura, cambiando los valores.
# Estos valores son solo para desarrollo local.

POSTGRES_DB=butacacero_db
POSTGRES_USER=butacacero
POSTGRES_PASSWORD=change-me-local-password

DJANGO_PORT=8000
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-local-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# En desarrollo local se pueden servir archivos subidos desde filesystem.
# DJANGO_SERVE_MEDIA=True
# En produccion, configurar Cloudinary para persistir media:
# CLOUDINARY_CLOUD_NAME=cloud-name
# CLOUDINARY_API_KEY=api-key
# CLOUDINARY_API_SECRET=api-secret
# Para deploys donde las imagenes deben ser persistentes:
# DJANGO_REQUIRE_CLOUDINARY=True
# Para dominios HTTPS adicionales en produccion:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.example

# En desarrollo se usa consola. En produccion se usa SMTP por defecto.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=usuario
# DJANGO_EMAIL_HOST_PASSWORD=password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=Butaca Cero <no-reply@example.com>

# Solo para inicializar un admin en hosting sin shell.
# DJANGO_CREATE_SUPERUSER=True
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
